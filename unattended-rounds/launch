#!/usr/bin/env bash
# Start the conductors of rounds ws-documents and aq-rewrite as background sessions.
# Run it from any directory. A conductor whose name is already listed by
# `claude agents` is left alone, since its prompt forbids a second launch.
set -euo pipefail

record="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$record"

live="$(claude agents --json)"

start() {
  local name="$1" prompt="$2"
  if grep -q "\"name\": \"$name\"" <<<"$live"; then
    echo "$name is already listed by claude agents; not started"
    return
  fi
  # /goal refuses a condition longer than 4000 characters and leaves the session blocked.
  local length
  length="$(wc -m <"$prompt")"
  if (( length > 4000 )); then
    echo "$prompt is $length characters, over /goal's 4000; $name not started" >&2
    return 1
  fi
  claude --bg --model sonnet --effort medium --name "$name" "$(cat "$prompt")"
}

start conductor-workstation plans/ws-documents-conductor-prompt.txt
start conductor-approval-queue plans/aq-rewrite-conductor-prompt.txt
