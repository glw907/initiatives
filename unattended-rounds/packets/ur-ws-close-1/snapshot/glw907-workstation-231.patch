+def test_pr_without_the_section_adds_nothing(tmp_path):
+    out = report(tmp_path, fixture("score_wins.json")).stdout
+    assert "## Planning misses\n\nNo miss lines in the window.\n" in out
+    assert "| Class |" not in out
