#!/usr/bin/env python3
"""Inventory the retire targets of scope.tsv: local state, GitHub state, Cloudflare ties.

Test seams: INVENTORY_CF_API (Cloudflare API base URL) and INVENTORY_GH (the gh command).
Credentials come from `source ~/.local/secrets` in a subshell and are never printed.
"""
import argparse
import fnmatch
import json
import os
import re
import socket
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request

TOOL = os.path.abspath(__file__)
ROOT = os.path.dirname(os.path.dirname(os.path.dirname(TOOL)))
SCOPE_TSV = os.path.join(ROOT, "repo-organization", "scope.tsv")
CF_API_DEFAULT = "https://api.cloudflare.com/client/v4"
SKIP_DIRS = {".git", "node_modules", ".claude", ".wrangler", ".svelte-kit", ".venv", "__pycache__"}
TEXT_SUFFIXES = {".md", ".json", ".jsonc", ".sh", ".yaml", ".yml", ".js", ".ts", ".mjs",
                 ".toml", ".txt", ".tsv", ".py", ".go", ".svelte", ".conf", ""}
CLAUDE_SKIP = {"worktrees", "shell-snapshots", "todos", "telemetry", "cache", "plugins",
               "file-history", "paste-cache", "session-env", "statsig", "ide", "downloads"}


class Fail(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def home():
    return os.environ.get("HOME", os.path.expanduser("~"))


def projects_root():
    return os.environ.get("PROJECTS_ROOT") or os.path.join(home(), "Projects")


def map_path(p):
    if p.startswith("~/Projects/"):
        return os.path.join(projects_root(), p[len("~/Projects/"):])
    if p.startswith("~/"):
        return os.path.join(home(), p[2:])
    return p


def read_scope():
    rows = []
    with open(SCOPE_TSV) as f:
        for line in f.read().splitlines()[1:]:
            repo, role, path = line.split("\t")
            rows.append({"repo": repo, "role": role, "path": map_path(path), "raw": path})
    return rows


def check_rows(rows, host):
    """Exit-nonzero on a missing edit/read row; mark absent rows."""
    for r in rows:
        r["absent"] = not os.path.exists(r["path"])
        if not r["absent"] or r["role"] == "retire":
            continue
        if r["role"] == "read" and host == "thinkpad-x1":
            continue
        raise Fail(f"scope row missing: {r['repo']} ({r['role']}) at {r['raw']}", 2)


def tool_sha():
    d = os.path.dirname(TOOL)
    try:
        sha = subprocess.run(["git", "-C", d, "rev-parse", "--short", "HEAD"], capture_output=True,
                             text=True, check=True).stdout.strip()
        dirty = subprocess.run(["git", "-C", d, "status", "--porcelain", "--", TOOL],
                               capture_output=True, text=True).stdout.strip()
        return sha + ("+dirty" if dirty else "")
    except (subprocess.CalledProcessError, OSError):
        return "unknown"


def git(path, *args):
    return subprocess.run(["git", "-C", path, *args], capture_output=True, text=True)


# ---------------------------------------------------------------- local leg

def kind_of(path):
    g = os.path.join(path, ".git")
    if os.path.isdir(g):
        return "git"
    if os.path.isfile(g):
        with open(g) as f:
            m = re.match(r"gitdir:\s*(.+)", f.read())
        if m:
            gd = m.group(1).strip()
            gd = gd if os.path.isabs(gd) else os.path.join(path, gd)
            if os.path.isdir(gd):
                return "git"
        return "orphaned-worktree"
    return "plain-dir"


def list_files(path):
    out = []
    for d, dirs, files in os.walk(path):
        dirs[:] = [x for x in dirs if x != ".git"]
        for fn in files:
            p = os.path.join(d, fn)
            try:
                out.append((os.path.relpath(p, path), int(os.lstat(p).st_mtime)))
            except OSError:
                pass
    return sorted(out)


def local_target(row):
    path = row["path"]
    if row["absent"]:
        return {"repo": row["repo"], "status": "absent"}
    kind = kind_of(path)
    t = {"repo": row["repo"], "status": "present", "kind": kind}
    if kind == "git":
        head = git(path, "rev-parse", "HEAD").stdout.strip()
        branches = {}
        for line in git(path, "for-each-ref", "--format=%(refname:short) %(objectname)",
                        "refs/heads").stdout.splitlines():
            n, s = line.split()
            branches[n] = s
        unpushed = [b for b in branches
                    if git(path, "rev-list", "--count", b, "--not", "--remotes").stdout.strip() not in ("", "0")]
        t.update({
            "head": head, "branches": branches, "unpushed_branches": unpushed,
            "stashes": git(path, "stash", "list").stdout.splitlines(),
            "uncommitted": len(git(path, "status", "--porcelain").stdout.splitlines()),
            "remotes": git(path, "remote").stdout.split(),
            "recoverable": True,
            "expect": {"head": head, "branches": branches},
        })
    else:
        files = list_files(path)
        newest = max((m for _, m in files), default=0)
        t.update({
            "recoverable": False, "file_count": len(files),
            "files": [{"path": p, "mtime": m} for p, m in files[:500]],
            "expect": {"newest_mtime": newest, "file_count": len(files)},
        })
    return t


def ref_regex(name):
    n = re.escape(name)
    return re.compile(rf"(?:Projects/{n}|glw907/{n})(?![\w-])")


def text_files(root, use_git=True):
    names = []
    if use_git and os.path.isdir(os.path.join(root, ".git")):
        r = git(root, "ls-files", "-z")
        names = [n for n in r.stdout.split("\0") if n]
    else:
        for d, dirs, files in os.walk(root):
            dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
            names += [os.path.relpath(os.path.join(d, f), root) for f in files]
    for n in names:
        if ".claude/worktrees/" in n or os.path.splitext(n)[1] not in TEXT_SUFFIXES:
            continue
        p = os.path.join(root, n)
        try:
            if os.path.getsize(p) > 1_000_000:
                continue
            with open(p, "rb") as f:
                data = f.read()
        except OSError:
            continue
        if b"\0" in data[:4096]:
            continue
        yield n, data.decode("utf-8", "replace")


def encode_project(p):
    return re.sub(r"[/.]", "-", os.path.abspath(p))


def claude_files(surviving):
    base = os.path.join(home(), ".claude")
    if not os.path.isdir(base):
        return
    enc = {encode_project(r["path"]) for r in surviving}
    for d, dirs, files in os.walk(base):
        rel = os.path.relpath(d, base)
        if rel == ".":
            dirs[:] = [x for x in dirs if x not in CLAUDE_SKIP]
        elif rel == "projects":
            dirs[:] = [x for x in dirs
                       if any(x == e or x.startswith(e + "--claude-worktrees") for e in enc)]
        elif rel.startswith("projects" + os.sep) and rel.count(os.sep) == 1:
            dirs[:] = [x for x in dirs if x == "memory"]
        for fn in files:
            if os.path.splitext(fn)[1] not in TEXT_SUFFIXES or fn.endswith(".jsonl"):
                continue
            p = os.path.join(d, fn)
            try:
                if os.path.getsize(p) > 1_000_000:
                    continue
                with open(p, errors="replace") as f:
                    yield os.path.relpath(p, base), f.read()
            except OSError:
                pass


def scan_refs(targets, surviving):
    """Return {target: [{where, path, line}]} for references from surviving repos and ~/.claude."""
    pats = {t["repo"]: ref_regex(t["repo"]) for t in targets}
    refs = {t["repo"]: [] for t in targets}

    def scan(where, rel, text):
        for i, line in enumerate(text.splitlines(), 1):
            for name, pat in pats.items():
                if pat.search(line):
                    refs[name].append({"where": where, "path": rel, "line": i})
    for r in surviving:
        if r["absent"]:
            continue
        for rel, text in text_files(r["path"]):
            scan(r["repo"], rel, text)
    for rel, text in claude_files(surviving):
        scan("~/.claude", rel, text)
    return refs


def manifest_entries(targets, workstation):
    names = {t["repo"]: re.compile(rf"(?<![\w.-]){re.escape(t['repo'])}(?![\w-])") for t in targets}
    out = {t["repo"]: [] for t in targets}
    cands = []
    if workstation and not workstation["absent"]:
        for rel, text in text_files(workstation["path"]):
            b = os.path.basename(rel)
            if re.match(r"^(Brewfile.*|.*bootstrap.*|\.bashrc)$", b):
                cands.append((f"workstation:{rel}", text))
    bashrc = os.path.join(home(), ".bashrc")
    if os.path.isfile(bashrc):
        with open(bashrc, errors="replace") as f:
            cands.append(("~/.bashrc", f.read()))
    for label, text in cands:
        for i, line in enumerate(text.splitlines(), 1):
            for name, pat in names.items():
                if pat.search(line) or ref_regex(name).search(line):
                    out[name].append({"file": label, "line": i, "text": line.strip()[:160]})
    return out


def registry_secrets(targets, workstation):
    out = {t["repo"]: [] for t in targets}
    if not workstation or workstation["absent"]:
        return out
    reg = os.path.join(workstation["path"], "secrets", "registry.md")
    if not os.path.isfile(reg):
        return out
    with open(reg, errors="replace") as f:
        text = f.read()
    for sec in re.split(r"(?m)^### ", text)[1:]:
        name, _, body = sec.partition("\n")
        m = re.search(r"(?s)- \*\*Used by\*\*:(.*?)(?=\n- \*\*|\n---|\Z)", body)
        if not m:
            continue
        for t in targets:
            if ref_regex(t["repo"]).search(m.group(1)):
                out[t["repo"]].append(name.strip())
    return out


def local_leg(rows):
    targets = [r for r in rows if r["role"] == "retire"]
    surviving = [r for r in rows if r["role"] != "retire"]
    ws = next((r for r in rows if r["repo"] == "workstation"), None)
    res = {t["repo"]: local_target(t) for t in targets}
    refs = scan_refs(targets, surviving)
    man = manifest_entries(targets, ws)
    sec = registry_secrets(targets, ws)
    for t in targets:
        res[t["repo"]].update({"references": refs[t["repo"]], "manifest_entries": man[t["repo"]],
                               "registry_secrets": sec[t["repo"]]})
    return res


# ---------------------------------------------------------------- network leg: GitHub

def gh(args):
    cmd = os.environ.get("INVENTORY_GH", "gh")
    r = subprocess.run([cmd, *args], capture_output=True, text=True)
    return r.returncode, r.stdout, r.stderr


def gh_ok(args):
    rc, out, err = gh(args)
    if rc != 0:
        if re.search(r"Could not resolve|HTTP 404|Not Found", err):
            return None
        raise Fail(f"gh {' '.join(args[:2])} failed: {err.strip()[:200]}")
    return out


def gh_json(args):
    out = gh_ok(args)
    if out is None:
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        raise Fail(f"gh {' '.join(args[:2])} returned malformed JSON")


def github_target(repo):
    owner = os.environ.get("INVENTORY_GH_OWNER", "glw907")
    full = f"{owner}/{repo}"
    view = gh_json(["repo", "view", full, "--json", "isFork,parent,defaultBranchRef"])
    if view is None:
        return {"repo": repo, "status": "no-github-repo"}
    default = (view.get("defaultBranchRef") or {}).get("name", "main")
    t = {"repo": repo, "status": "present", "fork": bool(view.get("isFork"))}
    t["open_prs"] = gh_json(["pr", "list", "-R", full, "--state", "open", "--json", "number,title"]) or []
    t["open_issues"] = gh_json(["issue", "list", "-R", full, "--state", "open", "--json", "number,title"]) or []
    t["releases"] = gh_json(["release", "list", "-R", full, "--json", "tagName"]) or []
    base, base_default, head_prefix = full, default, ""
    if t["fork"] and view.get("parent"):
        base = f"{view['parent']['owner']['login']}/{view['parent']['name']}"
        base_default = (gh_ok(["api", f"repos/{base}", "--jq", ".default_branch"]) or "main").strip()
        head_prefix = f"{owner}:"
        t["parent_open_prs"] = gh_json(["pr", "list", "-R", base, "--state", "open", "--author", owner,
                                        "--json", "number,title"]) or []
    names = (gh_ok(["api", f"repos/{full}/branches", "--paginate", "--jq", ".[].name"]) or "").split()
    ahead = []
    for b in names:
        if not head_prefix and b == default:
            continue
        n = (gh_ok(["api", f"repos/{base}/compare/{base_default}...{head_prefix}{b}",
                    "--jq", ".ahead_by"]) or "0").strip()
        if n.isdigit() and int(n) > 0:
            ahead.append({"branch": b, "ahead_by": int(n)})
    t["branches_not_in_upstream"] = ahead
    return t


# ---------------------------------------------------------------- network leg: Cloudflare

def credentials():
    script = ('source "$HOME/.local/secrets" >/dev/null 2>&1; '
              'printf "%s\\n%s\\n" "${CLOUDFLARE_API_TOKEN:-}" "${CLOUDFLARE_ACCOUNT_ID:-${CAIRN_CF_ACCOUNT_ID:-}}"')
    r = subprocess.run(["bash", "-c", script], capture_output=True, text=True)
    parts = r.stdout.split("\n")
    token, acct = parts[0], parts[1] if len(parts) > 1 else ""
    if not token:
        raise Fail("CLOUDFLARE_API_TOKEN is not set after sourcing ~/.local/secrets")
    return token, acct


class CF:
    def __init__(self, token, acct):
        self.base = os.environ.get("INVENTORY_CF_API", CF_API_DEFAULT).rstrip("/")
        self.token, self.acct = token, acct

    def get(self, path):
        shown = path.replace(self.acct, "<acct>") if self.acct else path
        items, page = [], 1
        while True:
            sep = "&" if "?" in path else "?"
            url = f"{self.base}{path}{sep}page={page}&per_page=100"
            req = urllib.request.Request(url, headers={"Authorization": f"Bearer {self.token}"})
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    status, raw = resp.status, resp.read()
            except urllib.error.HTTPError as e:
                raise Fail(f"Cloudflare API {shown}: HTTP {e.code}")
            except (urllib.error.URLError, OSError) as e:
                raise Fail(f"Cloudflare API {shown}: {type(e).__name__}")
            if status != 200:
                raise Fail(f"Cloudflare API {shown}: HTTP {status}")
            try:
                body = json.loads(raw)
            except json.JSONDecodeError:
                raise Fail(f"Cloudflare API {shown}: malformed JSON")
            if not isinstance(body, dict) or body.get("success") is not True or "result" not in body:
                raise Fail(f"Cloudflare API {shown}: unsuccessful or malformed answer")
            res = body["result"]
            if isinstance(res, list):
                items += res
                total = (body.get("result_info") or {}).get("total_pages", 1)
                if page < total:
                    page += 1
                    continue
                return items
            return res


def strip_jsonc(text):
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(c)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))


def parse_cfg(path):
    with open(path, errors="replace") as f:
        text = f.read()
    try:
        if path.endswith(".toml"):
            return tomllib.loads(text)
        return json.loads(strip_jsonc(text))
    except (tomllib.TOMLDecodeError, json.JSONDecodeError):
        raise Fail(f"malformed wrangler config: {os.path.basename(path)}")


def leaves(o):
    if isinstance(o, str):
        yield o
    elif isinstance(o, dict):
        for v in o.values():
            yield from leaves(v)
    elif isinstance(o, list):
        for v in o:
            yield from leaves(v)


def host_of(pattern):
    h = re.sub(r"^[a-z]+://", "", str(pattern)).split("/")[0]
    return h


def route_patterns(sec):
    vals = []
    if "route" in sec:
        vals.append(sec["route"])
    vals += sec.get("routes", []) or []
    return [v["pattern"] if isinstance(v, dict) else v for v in vals
            if (isinstance(v, str) or (isinstance(v, dict) and "pattern" in v))]


def cfg_facts(cfg):
    f = {"deploys": set(), "binds": set(), "kv": set(), "d1": set(), "r2": set(),
         "hosts": set(), "crons": set()}
    secs = [cfg] + [dict(e, name=e.get("name") or f"{cfg.get('name', '')}-{k}")
                    for k, e in (cfg.get("env") or {}).items() if isinstance(e, dict)]
    for s in secs:
        if s.get("name"):
            f["deploys"].add(s["name"])
        f["binds"] |= {b["service"] for b in s.get("services", []) if "service" in b}
        f["kv"] |= {b["id"] for b in s.get("kv_namespaces", []) if "id" in b}
        for b in s.get("d1_databases", []):
            f["d1"] |= {x for x in (b.get("database_id") or b.get("database_name"),) if x}
        f["r2"] |= {b["bucket_name"] for b in s.get("r2_buckets", []) if "bucket_name" in b}
        f["hosts"] |= {host_of(p) for p in route_patterns(s)}
        f["crons"] |= set((s.get("triggers") or {}).get("crons", []))
    return f


def repo_files(repo_path):
    cfgs, flows = [], []
    for d, dirs, files in os.walk(repo_path):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
        rel = os.path.relpath(d, repo_path)
        if rel.count(os.sep) > 3:
            dirs[:] = []
        for fn in files:
            if fn in ("wrangler.toml", "wrangler.json", "wrangler.jsonc"):
                cfgs.append(os.path.join(d, fn))
    wf = os.path.join(repo_path, ".github", "workflows")
    if os.path.isdir(wf):
        for fn in sorted(os.listdir(wf)):
            if fn.endswith((".yml", ".yaml")):
                flows.append(os.path.join(wf, fn))
    return cfgs, flows


def workflow_names(text):
    text = re.sub(r"\\\n", " ", text)
    names = set()
    for line in text.splitlines():
        if "wrangler" in line:
            names |= set(re.findall(r"--name[= ]+['\"]?([\w.-]+)", line))
    return names


class Repo:
    """The wrangler-derived facts of one repo (configs plus deploy workflows)."""

    def __init__(self, row):
        self.name, self.role = row["repo"], row["role"]
        self.facts = {"deploys": set(), "binds": set(), "kv": set(), "d1": set(), "r2": set(),
                      "hosts": set(), "crons": set()}
        self.leaves, self.blob = set(), ""
        if row["absent"]:
            return
        cfgs, flows = repo_files(row["path"])
        for c in cfgs:
            cfg = parse_cfg(c)
            for k, v in cfg_facts(cfg).items():
                self.facts[k] |= v
            self.leaves |= set(leaves(cfg))
        for w in flows:
            with open(w, errors="replace") as f:
                text = f.read()
            self.blob += "\n" + text
            self.facts["deploys"] |= workflow_names(text)

    def claims_worker(self, name):
        return name in self.facts["deploys"] or name in self.facts["binds"]

    def claims(self, value):
        return value in self.leaves or bool(
            re.search(rf"(?<![\w.-]){re.escape(value)}(?![\w-])", self.blob))

    def covers_host(self, host):
        pats = self.facts["hosts"] | ({host} if re.search(rf"(?<![\w.-]){re.escape(host)}(?![\w-])", self.blob) else set())
        return any(fnmatch.fnmatch(host, p) or fnmatch.fnmatch(p, host) for p in pats)


class Cloud:
    """The account state the inventory reads, fetched once."""

    def __init__(self, cf, target_names):
        a = cf.acct
        self.workers = [s["id"] for s in cf.get(f"/accounts/{a}/workers/scripts")]
        if "pings" not in self.workers:
            raise Fail("account Worker list lacks the pings Worker; an empty list must not read as no ties")
        self.bindings = {w: (cf.get(f"/accounts/{a}/workers/scripts/{w}/settings") or {}).get("bindings", [])
                         for w in self.workers}
        self.schedules = {w: [s["cron"] for s in (cf.get(f"/accounts/{a}/workers/scripts/{w}/schedules") or {}).get("schedules", [])]
                          for w in self.workers if w in target_names}
        self.domains = cf.get(f"/accounts/{a}/workers/domains")
        self.d1 = {d["uuid"] for d in cf.get(f"/accounts/{a}/d1/database")}
        self.kv = {k["id"] for k in cf.get(f"/accounts/{a}/storage/kv/namespaces")}
        self.r2 = {b["name"] for b in (cf.get(f"/accounts/{a}/r2/buckets") or {}).get("buckets", [])}
        self.apps = cf.get(f"/accounts/{a}/access/apps")
        self.routes, self.dns, self.email = [], [], []
        for z in cf.get("/zones"):
            self.routes += cf.get(f"/zones/{z['id']}/workers/routes")
            self.dns += cf.get(f"/zones/{z['id']}/dns_records")
            self.email += cf.get(f"/zones/{z['id']}/email/routing/rules")

    def binders(self, kind, rid):
        """Workers whose settings bind the resource."""
        field = {"kv": ("kv_namespace", "namespace_id"), "d1": ("d1", "id"),
                 "r2": ("r2_bucket", "bucket_name"), "service": ("service", "service")}[kind]
        return {w for w, bs in self.bindings.items()
                for b in bs if b.get("type") == field[0] and b.get(field[1]) == rid}


def app_hosts(app):
    raw = [app.get("domain")] + list(app.get("self_hosted_domains") or []) + \
          [d.get("uri") for d in app.get("destinations") or [] if isinstance(d, dict)]
    return sorted({host_of(x) for x in raw if x})


def network_leg(rows, target_rows):
    token, acct = credentials()
    cf = CF(token, acct)
    if not acct:
        accts = cf.get("/accounts")
        if len(accts) != 1:
            raise Fail("cannot pick a Cloudflare account: set CLOUDFLARE_ACCOUNT_ID")
        cf.acct = acct = accts[0]["id"]
    survivors = [Repo(r) for r in rows if r["role"] != "retire" and not r["absent"]]
    targets = {r["repo"]: Repo(r) for r in target_rows if not r["absent"]}
    target_workers = set().union(*[t.facts["deploys"] for t in targets.values()]) if targets else set()
    cloud = Cloud(cf, target_workers)

    def owners_of_worker(w):
        return sorted(s.name for s in survivors if s.claims_worker(w))

    def judge(kind, rid, claimed_by, binder_kind=None, extra_binders=()):
        """Return the ownership status for a resource, or the survivor repos sharing it."""
        repos = set(claimed_by)
        outside = False
        binders = set(cloud.binders(binder_kind, rid) if binder_kind else ()) | set(extra_binders)
        for b in binders - target_workers:
            own = owners_of_worker(b)
            if own:
                repos |= set(own)
            else:
                outside = True
        if repos:
            return "shared-with " + ",".join(sorted(repos))
        return "shared-out-of-scope" if outside else "sole-owner"

    def worker_binders(name):
        return {w for w, bs in cloud.bindings.items() for b in bs
                if b.get("type") == "service" and b.get("service") == name}

    def host_status(host, route_workers=()):
        repos = {s.name for s in survivors if s.covers_host(host)}
        outside = False
        for w in route_workers:
            if w not in target_workers:
                own = owners_of_worker(w)
                repos |= set(own)
                outside = outside or not own
        if repos:
            return "shared-with " + ",".join(sorted(repos))
        return "shared-out-of-scope" if outside else "sole-owner"

    out = {}
    for tname, t in targets.items():
        ties = []

        def add(kind, rid, status, relation="derived", **kw):
            ties.append({"kind": kind, "id": rid, "status": status, "expect": status,
                         "relation": relation, **kw})
        host_workers = {}
        for r in cloud.routes:
            host_workers.setdefault(host_of(r["pattern"]), set()).add(r.get("script"))
        for d in cloud.domains:
            host_workers.setdefault(d["hostname"], set()).add(d.get("service"))
        for w in sorted(t.facts["deploys"]):
            if w not in cloud.workers:
                add("worker", w, "not-deployed", "deploys")
                continue
            claimed = {s.name for s in survivors if s.claims_worker(w)}
            add("worker", w, judge("worker", w, claimed, extra_binders=worker_binders(w) - {w}), "deploys")
        for w in sorted(t.facts["binds"] - t.facts["deploys"]):
            claimed = {s.name for s in survivors if s.claims_worker(w)}
            st = "shared-with " + ",".join(sorted(claimed)) if claimed else "not-target-deployed"
            add("worker", w, st, "binds")
        for w in sorted(t.facts["deploys"] & set(cloud.workers)):
            wstat = next(x["status"] for x in ties if x["kind"] == "worker" and x["id"] == w and x["relation"] == "deploys")
            for c in sorted(set(cloud.schedules.get(w, [])) | t.facts["crons"]):
                add("cron", f"{w}:{c}", wstat)
        for kind, live in (("kv", cloud.kv), ("d1", cloud.d1), ("r2", cloud.r2)):
            for rid in sorted(t.facts[kind]):
                claimed = {s.name for s in survivors if s.claims(rid)}
                st = judge(kind, rid, claimed, binder_kind=kind)
                if st == "sole-owner" and kind != "d1" and rid not in live:
                    st = "absent-in-account"
                if st == "sole-owner" and kind == "d1" and not (rid in live or not re.match(r"^[0-9a-f-]{36}$", rid)):
                    st = "absent-in-account"
                add(kind, rid, st)
        hosts = set(t.facts["hosts"]) | {h for h, ws in host_workers.items() if ws & t.facts["deploys"]}
        for h in sorted(hosts):
            add("route", h, host_status(h, host_workers.get(h, ())))
        for rec in cloud.dns:
            if rec["name"] in hosts:
                add("dns", rec["id"], host_status(rec["name"], host_workers.get(rec["name"], ())),
                    name=rec["name"], type=rec.get("type"))
        for app in cloud.apps:
            ah = app_hosts(app)
            if not set(ah) & hosts:
                continue
            repos = {s.name for s in survivors if any(s.covers_host(h) for h in ah)}
            outside = any(h not in hosts and not any(s.covers_host(h) for s in survivors) for h in ah)
            st = ("shared-with " + ",".join(sorted(repos)) if repos
                  else "shared-out-of-scope" if outside else "sole-owner")
            add("access-app", app["id"], st, name=app.get("name"), hosts=ah)
        for rule in cloud.email:
            ws = {v for a in rule.get("actions", []) if a.get("type") == "worker" for v in a.get("value", [])}
            if ws & t.facts["deploys"]:
                add("email-routing", rule["id"], "sole-owner" if ws <= target_workers else "shared-out-of-scope")
        out[tname] = {"repo": tname, "cloudflare": ties}
    return out


# ---------------------------------------------------------------- output

def render(res):
    lines = []
    for name, t in res.get("local", {}).items():
        if t["status"] == "absent":
            lines.append(f"local   {name}  absent")
            continue
        if t["kind"] == "git":
            lines.append(f"local   {name}  git  branches={len(t['branches'])} "
                         f"unpushed={len(t['unpushed_branches'])} stashes={len(t['stashes'])} "
                         f"uncommitted={t['uncommitted']}")
            for b in t["unpushed_branches"]:
                lines.append(f"          unpushed {b}")
        else:
            lines.append(f"local   {name}  {t['kind']}  files={t['file_count']} UNRECOVERABLE once removed")
            for f in t["files"][:10]:
                lines.append(f"          {f['mtime']}  {f['path']}")
        for r in t["references"][:20]:
            lines.append(f"          ref {r['where']}:{r['path']}:{r['line']}")
        if len(t["references"]) > 20:
            lines.append(f"          ref ... {len(t['references'])} in all")
        for m in t["manifest_entries"]:
            lines.append(f"          manifest {m['file']}:{m['line']}  {m['text']}")
        for s in t["registry_secrets"]:
            lines.append(f"          secret {s}")
    for name, t in res.get("github", {}).items():
        if t["status"] != "present":
            lines.append(f"github  {name}  {t['status']}")
            continue
        lines.append(f"github  {name}  prs={len(t['open_prs'])} issues={len(t['open_issues'])} "
                     f"releases={len(t['releases'])} branches-not-in-upstream={len(t['branches_not_in_upstream'])}"
                     + (f" parent-prs={len(t['parent_open_prs'])}" if "parent_open_prs" in t else ""))
    for name, t in res.get("cloudflare", {}).items():
        for x in t["cloudflare"]:
            lines.append(f"cf      {name}  {x['kind']}  {x['id']}  {x['status']}")
    return lines


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--local", action="store_true")
    ap.add_argument("--network", action="store_true")
    ap.add_argument("--host", default=socket.gethostname().split(".")[0])
    ap.add_argument("--out")
    a = ap.parse_args()
    do_local = a.local or not a.network
    do_net = a.network or not a.local
    sha = tool_sha()
    print(f"inventory {sha}")
    try:
        rows = read_scope()
        check_rows(rows, a.host)
        targets = [r for r in rows if r["role"] == "retire"]
        res = {"tool_sha": sha, "host": a.host}
        if do_local:
            res["local"] = local_leg(rows)
        if do_net:
            res["github"] = {t["repo"]: github_target(t["repo"]) for t in targets}
            res["cloudflare"] = network_leg(rows, targets)
    except Fail as e:
        print(f"inventory: {e}", file=sys.stderr)
        return e.code
    if a.out:
        with open(a.out, "w") as f:
            json.dump(res, f, indent=2, sort_keys=True)
            f.write("\n")
    print("\n".join(render(res)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
