#!/usr/bin/env python3
"""Extract paths with their history into a fresh clone and verify the result.

Writes <state-dir>/extracts/<name>/repo and verify.txt beside it. Every historical path (old
names of renamed files included) must be listed with --path, or the first-commit check fails.
"""
import argparse
import os
import subprocess
import sys

TOOL_DIR = os.path.dirname(os.path.abspath(__file__))
ZERO = "0" * 40


def git(path, *args, check=True):
    out = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True)
    if check and out.returncode != 0:
        raise SystemExit(f"extract: git {' '.join(args)} failed: {out.stderr.strip()}")
    return out.stdout


def tool_sha():
    out = subprocess.run(["git", "-C", TOOL_DIR, "rev-parse", "HEAD"], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else "unknown"


def first_commit(repo, rev, path):
    shas = git(repo, "log", "--follow", "--diff-filter=A", "--format=%H", rev, "--", path).split()
    return shas[-1] if shas else ""


def tree(repo, rev, paths):
    args = ["ls-tree", "-r", rev] + (["--", *paths] if paths else [])
    return git(repo, *args).splitlines()


def verify(source, repo, pin, paths):
    """Return the verify.txt lines and whether both checks passed."""
    lines, good = [], True
    want, have = sorted(tree(source, pin, paths)), sorted(tree(repo, "HEAD", None))
    if want == have:
        lines.append("tip-tree: ok")
    else:
        good = False
        lines.append("tip-tree: MISMATCH")
        lines += [f"  only in source: {e}" for e in sorted(set(want) - set(have))]
        lines += [f"  only in extract: {e}" for e in sorted(set(have) - set(want))]
    cmap = {}
    with open(os.path.join(repo, ".git", "filter-repo", "commit-map")) as f:
        for ln in f.read().splitlines()[1:]:
            old, _, new = ln.partition(" ")
            cmap[old] = new
    for entry in have:
        path = entry.split("\t", 1)[1]
        src = first_commit(source, pin, path)
        mapped = cmap.get(src, ZERO)
        got = first_commit(repo, "HEAD", path)
        same = bool(src) and mapped != ZERO and mapped == got
        good = good and same
        lines.append(f"first-commit {path}: source={src[:12]} mapped={mapped[:12]} extract={got[:12]} "
                     + ("ok" if same else "MISMATCH"))
    return lines, good


def run(args):
    dest = os.path.join(args.state_dir, "extracts", args.name)
    if os.path.exists(dest):
        raise SystemExit(f"extract: {dest} already exists; remove it deliberately to redo")
    repo = os.path.join(dest, "repo")
    os.makedirs(dest)
    pin = git(args.source, "rev-parse", "HEAD").strip()
    # A fresh clone, never moved afterwards: filter-repo aborts when HEAD's reflog has extra entries.
    subprocess.run(["git", "clone", "-q", "--no-local", args.source, repo], check=True)
    cmd = ["git", "-C", repo, "filter-repo"]
    for p in args.path:
        cmd += ["--path", p]
    subprocess.run(cmd, check=True)
    lines, good = verify(args.source, repo, pin, args.path)
    report = [f"pin {pin}", f"tool {tool_sha()}", f"name {args.name}"]
    report += [f"path {p}" for p in args.path] + lines
    if good:
        report.append("verified")
    else:
        report.append("NOT VERIFIED")
    text = "\n".join(report) + "\n"
    with open(os.path.join(dest, "verify.txt"), "w") as f:
        f.write(text)
    sys.stdout.write(text)
    return 0 if good else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--source", required=True)
    ap.add_argument("--state-dir", required=True)
    ap.add_argument("--name", required=True)
    ap.add_argument("--path", action="append", required=True)
    sys.exit(run(ap.parse_args()))


if __name__ == "__main__":
    main()
