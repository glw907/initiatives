From 2c69e5da675e082a78655720218d6a86c1862e61 Mon Sep 17 00:00:00 2001
From: glw907 <geoff-login@907.life>
Date: Sun, 18 Oct 2026 16:53:40 -0800
Subject: [PATCH 4/4] Fix the rotate blueprint's third whole-read findings

The logs query gets rows for the health events, the checks name curl.exe for Windows, and two
small wording gaps close.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../rotate-the-github-app-key.blueprint.yaml  | 38 ++++++++++++++++++-
 1 file changed, 37 insertions(+), 1 deletion(-)

diff --git a/blueprints/docs/extend/rotate-the-github-app-key.blueprint.yaml b/blueprints/docs/extend/rotate-the-github-app-key.blueprint.yaml
index dab7d2fb9..531d10dd6 100644
--- a/blueprints/docs/extend/rotate-the-github-app-key.blueprint.yaml
+++ b/blueprints/docs/extend/rotate-the-github-app-key.blueprint.yaml
@@ -317,6 +317,12 @@ sections:
         use: |
           Only the route's placement at the site root. The status codes wait for
           [[verify-the-new-key]].
+      - id: bb-curl
+        kind: sentence
+        mode: verbatim
+        text: |
+          The checks on this page use `curl`. On Windows PowerShell, call `curl.exe`, because
+          `curl` there is an alias for a different command.
       - id: bb-healthz-link
         kind: link
         target: ../reference/sveltekit.md#loadhealth
@@ -888,6 +894,27 @@ sections:
         handledBy: s-rec-checks
         facts:
           - f:7u49xs
+      - id: x-logs-health-failed
+        kind: failure
+        from: s-logs
+        symptom: |
+          A `health.failed` event carries the error the check threw.
+        cause: |
+          The check itself threw, which the anonymous route never shows.
+        handledBy: rec-health-handoff
+        facts:
+          - f:paotzb
+      - id: x-logs-health-scope
+        kind: failure
+        from: s-logs
+        symptom: |
+          A `github.unreachable` event carries `scope: 'health'` and the failure class as `reason`.
+        cause: |
+          The live check's mint failed.
+        handledBy: rec-live-handoff
+        facts:
+          - f:1pb077
+          - f:7u49xs
       - id: x-logs-empty
         kind: failure
         from: s-logs
@@ -898,6 +925,14 @@ sections:
         handledBy: rec-logs-on-link
         facts:
           - f:prb2os
+      - id: rec-health-handoff
+        kind: handoff
+        text: |
+          Fix what the logged error names, then run the three checks in [[verify-the-new-key]] again.
+      - id: rec-live-handoff
+        kind: handoff
+        text: |
+          Read the `reason` against the rows for `/healthz?live=1` in this section.
       - id: rec-logs-on-link
         kind: link
         target: '#before-you-begin'
@@ -930,7 +965,7 @@ sections:
         kind: sentence
         mode: claim
         text: |
-          The opening's two routes, with their condition first: before the deletion and with the
+          The two recovery routes, with their condition first: before the deletion and with the
           old key's file, roll back; after the deletion, or with no copy of the old key, generate a
           third key.
         facts:
@@ -1009,6 +1044,7 @@ sections:
         text: |
           On the App's settings page on GitHub, delete the failed key, the one you generated for
           this rotation. Its fingerprint differs from the `fingerprint` that `/healthz` returned.
+          Leave any other key you keep.
         requires:
           - old-key-identified
         produces:
-- 
