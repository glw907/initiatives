+++ b/blueprints/docs/extend/rotate-the-github-app-key.blueprint.yaml
@@ -480,9 +480,8 @@ sections:
         kind: fact
         fact: f:dbue4k
         use: |
-          Only two clauses: `[Convert]::ToBase64String` returns unwrapped base64, and the form pipes
